-- 도서코드 / 도서명 / 분류명 / 1일대여료
select tb.book_code 도서코드, tb.book_name 도서명, tbc.cat_name 분류명, tb.daily_ree
from tbl_book tb left outer join tbl_book_category tbc on tb.cat_code= tbc.cat_code;

-- 대여일자 / 대여번호 / 도서명 / 분류명 / 대여일수  / 1일대여료 / 대여요금 / 대여자명
select tr.rent_date 대여일자, tr.rent_no 대여번호, tb.book_name 도서명,tbc.cat_name 분류명,tr.rent_days 대여일수, tb.daily_ree 1일대여료,
		sum(tr.rent_days*tb.daily_ree) 대여요금, tr.borrower_name 대여자명
from tbl_rental tr left outer join tbl_book tb on tr.book_code = tb.book_code
		left outer join tbl_book_category tbc on tbc.cat_code = tb.cat_code
group by tr.rent_date, tr.rent_no ;

-- 분류코드 / 분류명 / 대여건수 / 총 대여일수 / 총대여금액

select tbc.cat_code 분류코드, tbc.cat_name 분류명, count(rent_days) 대여건수, sum(rent_days) 총대여일수, sum(tr.rent_days*tb.daily_ree) 총대여요금
from tbl_book_category tbc left outer join tbl_book tb on tbc.cat_code = tb.cat_code
 left outer join tbl_rental tr on tb.book_code = tr.book_code
group by tbc.cat_code, tbc.cat_name with rollup;
