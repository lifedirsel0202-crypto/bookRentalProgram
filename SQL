create table TBL_RENTAL(
RENT_NO CHAR(5) NOT NULL,
RENT_DATE CHAR(8) NOT NULL,
BOOK_CODE CHAR(5) NOT NULL,
RENT_DAYS INTEGER(2) CHECK(RENT_DAYS BETWEEN 1 AND 14 ) NOT NULL,
BORROWER_NAME VARCHAR(20) NOT NULL,
PRIMARY KEY(RENT_NO),
FOREIGN KEY(BOOK_CODE) REFERENCES TBL_BOOK(BOOK_CODE));

