create table TBL_BOOK(
BOOK_CODE CHAR(5) NOT NULL,
BOOK_NAME VARCHAR(30) NOT NULL,
cat_code CHAR(2) NOT NULL,
DAILY_FEE integer(8) NOT NULL,
PRIMARY KEY(BOOK_CODE),
FOREIGN KEY(cat_code) REFERENCES tbl_book_category(cat_code));

