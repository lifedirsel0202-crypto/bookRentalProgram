-- 도서코드 / 도서명 / 분류명 / 1일 대여료
select tb.book_code 도서코드, tb.book_name 도서명, tbc.cat_name 분류명, tb.daily_fee 1일대여료
from tbl_book tb left outer join tbl_book_category tbc on tb.cat_code = tbc.cat_code;
('R0006','20261008','B2002',2,'오윤재'),
